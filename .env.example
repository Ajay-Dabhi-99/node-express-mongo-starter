# ───────────────────────── App ─────────────────────────
NODE_ENV=development
APP_NAME=node-express-mongo-starter
PORT=4000
API_PREFIX=/api/v1
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug

# ───────────────────── MongoDB Atlas ───────────────────
# Atlas → Database → Connect → Drivers → copy the connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Database name (use a different one per environment: myapp_dev, myapp_prod)
MONGODB_DB_NAME=myapp_dev
MONGODB_MAX_POOL_SIZE=10
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000

# ─────────────────────── HTTP / Security ───────────────
# Comma separated list of allowed frontend origins ("*" = allow all, dev only)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Number of proxies in front of the app (Render/Railway/Nginx = 1, local = 0)
TRUST_PROXY=0
BODY_LIMIT=100kb
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# ───────────────────────── Misc ────────────────────────
# Swagger UI at /docs (set false in production if the API is private)
DOCS_ENABLED=true
SHUTDOWN_TIMEOUT_MS=10000

# --- auth:start ---
# ─────────────── Auth module (optional) ────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-generate-a-long-random-secret-of-at-least-32-chars
JWT_ACCESS_EXPIRES_IN_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_SALT_ROUNDS=12
# Used by: npm run seed:admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe@12345
SEED_ADMIN_NAME=Admin
# --- auth:end ---
